void main() {
#if defined(BARRICADE_STAGE) && BARRICADE_STAGE == 0
    if (stage==0) { int local=int(gl_GlobalInvocationID.x); int id=batchBase+local; if (local<batchCount && id<a[11]) evaluate(id); }
#elif defined(BARRICADE_STAGE) && BARRICADE_STAGE == 1
    if (int(gl_GlobalInvocationID.x)>=batchCount) return;
    if (stage==1) { int owner=batchBase+int(gl_GlobalInvocationID.x); if (owner<a[7]) propose(owner); }
    else if (stage==2) { int owner=batchBase+int(gl_GlobalInvocationID.x); if (owner<a[7]) screen(owner); }
    else if (stage==3) { int owner=batchBase+int(gl_GlobalInvocationID.x); if (owner<a[7]) applyOwner(owner); }
#else
    if (stage==0) { int id=batchBase+int(gl_GlobalInvocationID.x); if (id<a[11]) evaluate(id); }
    else if (stage==1) { int owner=batchBase+int(gl_GlobalInvocationID.x); if (owner<a[7]) propose(owner); }
    else if (stage==2) { int owner=batchBase+int(gl_GlobalInvocationID.x); if (owner<a[7]) screen(owner); }
    else if (stage==3) { int owner=batchBase+int(gl_GlobalInvocationID.x); if (owner<a[7]) applyOwner(owner); }
#endif
}
